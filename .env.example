LLM_PROVIDER=deepseek

KIMI_API_KEY=replace-with-your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://models.sjtu.edu.cn/api/v1
DEEPSEEK_MODEL=deepseek-chat

# The SJTU server can reuse AI_API_KEY and AI_API_BASE from /etc/course-ai.env.
AI_API_KEY=
AI_API_BASE=
AI_MODEL=

# Maximum time without response data for one model request. Profile and report
# generation are separate requests, so one complete job may take longer.
LLM_TIMEOUT_SECONDS=600

# Optional XFYUN file-transcription large model. Keep disabled until the
# school's privacy review and XFYUN service authorization are complete.
SPEECH_PROVIDER=disabled
SPEECH_XFYUN_APP_ID=
SPEECH_XFYUN_API_KEY=
SPEECH_XFYUN_API_SECRET=
SPEECH_XFYUN_BASE_URL=https://office-api-ist-dx.iflyaisol.com
SPEECH_XFYUN_LANGUAGE=autodialect
SPEECH_XFYUN_DOMAIN=edu
SPEECH_XFYUN_POLL_INTERVAL_SECONDS=1.5
SPEECH_XFYUN_POLL_TIMEOUT_SECONDS=120
SPEECH_TIMEOUT_SECONDS=30
SPEECH_MAX_FILE_MB=10
SPEECH_DAILY_LIMIT=0
SPEECH_QUOTA_TIMEZONE=Asia/Shanghai

# Local frontend dev server and Docker/Nginx frontend origins.
# For production, replace these with your real public URL.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost

# Local Vite dev server reads this from the root .env.
# Docker frontend builds still use /api through docker-compose.yml.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BASE_PATH=/
VITE_ENABLE_LOCAL_AUTH=true

# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-64-random-characters
AUTH_TOKEN_HOURS=72
LOCAL_AUTH_ENABLED=true

# Production jAccount SSO. Keep PORTAL_SESSION_SECRET out of source control.
PORTAL_SESSION_SECRET=
PORTAL_SESSION_COOKIE_NAME=session
PORTAL_LOGIN_URL=https://ai4edu.sjtu.edu.cn/auth/jaccount/login
PORTAL_LOGOUT_URL=https://ai4edu.sjtu.edu.cn/auth/logout
PUBLIC_APP_URL=http://localhost:5173
APP_BASE_PATH=/

# Emergency switch for report-generation incidents. When true, students can
# still sign in, edit/save drafts, poll existing jobs and view reports, but new
# report-generation submissions return HTTP 503 and the frontend shows a notice.
ASSESSMENT_SUBMISSION_MAINTENANCE=false
ASSESSMENT_SUBMISSION_MAINTENANCE_MESSAGE=报告生成服务正在维护，现暂停新提交和报告生成。请勿重复提交、清理浏览器缓存或更换设备，以免丢失本机已填写内容。请保留当前浏览器；恢复后请先查看结果，我们会另行通知需要补充信息的同学。

# Report generation quota and durable PostgreSQL job worker.
# 0 disables the daily quota. GENERATION_MAX_CONCURRENCY limits simultaneous
# model pipelines in this one-worker deployment; accepted jobs remain queued in
# PostgreSQL. Keep the lease longer than the heartbeat interval.
REPORT_GENERATION_DAILY_LIMIT=0
REPORT_GENERATION_QUOTA_TIMEZONE=Asia/Shanghai
GENERATION_MAX_CONCURRENCY=4
GENERATION_JOB_LEASE_SECONDS=300
GENERATION_JOB_HEARTBEAT_SECONDS=30
GENERATION_JOB_RETENTION_DAYS=30
ASSESSMENT_DRAFT_RETENTION_DAYS=30
ADMIN_AUDIT_RETENTION_DAYS=180

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=系统管理员

POSTGRES_DB=siyuan_compass
POSTGRES_USER=siyuan
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Use 8080 for local Docker. Use 80 when another reverse proxy or cloud load balancer handles HTTPS.
HTTP_PORT=8080
